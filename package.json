{
	"name": "openinsight",
	"version": "0.15.0",
	"description": "Query your database with natural language",
	"license": "MIT",
	"author": "Arjun Komath",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arjunkomath/openinsight.git"
	},
	"homepage": "https://github.com/arjunkomath/openinsight#readme",
	"bugs": {
		"url": "https://github.com/arjunkomath/openinsight/issues"
	},
	"packageManager": "bun@1.4.0",
	"keywords": [
		"database",
		"sql",
		"ai",
		"cli",
		"terminal",
		"query",
		"postgresql",
		"mysql",
		"sqlite",
		"natural-language",
		"openrouter",
		"claude",
		"gemini",
		"opentui",
		"bun"
	],
	"bin": {
		"openinsight": "bin/openinsight.js"
	},
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"start": "bun source/cli.js",
		"start:web": "bun source/cli.js --web",
		"dev": "bun --watch source/cli.js",
		"dev:web": "bun --watch source/cli.js --web",
		"format": "prettier --write .",
		"test": "prettier --check . && bun test --parallel"
	},
	"files": [
		"bin"
	],
	"devDependencies": {
		"@openrouter/ai-sdk-provider": "^3.0.0",
		"@opentui/core": "^0.5.6",
		"@opentui/react": "^0.5.6",
		"@types/react": "^19.2.18",
		"ai": "^7.0.76",
		"prettier": "^3.9.6",
		"react": "^19.2.8",
		"zod": "^4.4.3"
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"bracketSpacing": false,
		"trailingComma": "all",
		"arrowParens": "avoid"
	}
}
